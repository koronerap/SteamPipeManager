<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux ve macOS paketlerini Windows'ta üretmek için. PowerShell 5.1 tar yazamıyor
    ve zip çalıştırma iznini taşımıyor; bu araç tar.gz'yi izinleriyle yazıyor ve
    macOS .app paketini kuruyor. publish.ps1 çağırıyor.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
