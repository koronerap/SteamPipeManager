<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:SteamPipeManager.Desktop.Localization"
             xmlns:c="using:SteamPipeManager.Desktop.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="SteamPipeManager.Desktop.Views.EpicWorkspaceView">

    <Grid ColumnDefinitions="240,*">

        <!-- Sol: hedef listesi -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,16,0">
            <TextBlock Grid.Row="0" Text="{loc:T Epic.Artifacts}" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,10" />

            <ListBox Grid.Row="1" ItemsSource="{Binding Artifacts}" SelectedItem="{Binding SelectedCard}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,5">
                            <Border Width="34" Height="34" CornerRadius="6" Background="#2F6FEB">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Hızlı build: hedefi seçip Build sekmesine geçerek başlatır. -->
                            <Button Grid.Column="2" Classes="subtle" Padding="6,4" VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:T Apps.QuickBuild.Tip}"
                                    ToolTip.Tip="{loc:T Apps.QuickBuild.Tip}"
                                    Command="{Binding $parent[ListBox].DataContext.QuickBuildCommand}"
                                    CommandParameter="{Binding}">
                                <ic:SymbolIcon Symbol="CloudArrowUp" FontSize="16" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Padding="6,4" VerticalAlignment="Center"
                                    AutomationProperties.Name="{loc:T Epic.Delete.Tip}"
                                    ToolTip.Tip="{loc:T Epic.Delete.Tip}"
                                    Command="{Binding $parent[ListBox].DataContext.DeleteArtifactCommand}"
                                    CommandParameter="{Binding}">
                                <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                    ToolTip.Tip="{loc:T Epic.AddArtifact.Tip}" Command="{Binding AddArtifactCommand}">
                <c:IconLabel Symbol="Add" Text="{loc:T Epic.AddArtifact}" />
            </Button>
        </Grid>

        <!-- Sağ: seçili hedefin ayarları -->
        <Panel Grid.Column="1">
            <TextBlock Text="{loc:T Epic.SelectPrompt}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasSelection}" />

            <TabControl SelectedIndex="{Binding SelectedTabIndex}" IsVisible="{Binding HasSelection}">

                <TabItem Header="{loc:T Tab.General}">
                    <ScrollViewer Padding="16">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Classes="label" Text="{loc:T Epic.ProductId}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ProductId}" />
                            <TextBlock Classes="hint" Text="{loc:T Epic.ProductId.Hint}" />

                            <TextBlock Classes="label" Text="{loc:T General.Title}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding Selected.Title}" />

                            <TextBlock Classes="label" Text="{loc:T General.Kind}" />
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Selected.Kind}" />

                            <TextBlock Classes="label" Text="{loc:T Epic.ArtifactId}" />
                            <TextBox Text="{Binding Selected.ArtifactId}" />

                            <TextBlock Classes="label" Text="{loc:T Epic.BuildRoot}" Margin="0,16,0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding Selected.BuildRoot}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                        AutomationProperties.Name="{loc:T Common.PickFolder}"
                                        ToolTip.Tip="{loc:T Common.PickFolder}"
                                        Command="{Binding BrowseBuildRootCommand}">
                                    <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="hint" Text="{loc:T Epic.BuildRoot.Hint}" />

                            <TextBlock Classes="label" Text="{loc:T Epic.AppLaunch}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding Selected.AppLaunch}" Watermark="Game.exe" />

                            <TextBlock Classes="label" Text="{loc:T Epic.AppArgs}" />
                            <TextBox Text="{Binding Selected.AppArgs}" />

                            <TextBlock Classes="label" Text="{loc:T Epic.CloudDir}" Margin="0,16,0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding Selected.CloudDir}" Watermark="{loc:T Epic.CloudDir.Placeholder}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                        AutomationProperties.Name="{loc:T Common.PickFolder}"
                                        ToolTip.Tip="{loc:T Common.PickFolder}"
                                        Command="{Binding BrowseCloudDirCommand}">
                                    <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="hint" Text="{loc:T Epic.CloudDir.Hint}" />

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,20,0,0" Opacity="0.55">
                                <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T Common.AutoSaved}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Yayın: Epic'te canlıya alma ayrı bir çağrı olduğu için ayrı sekme -->
                <TabItem Header="{loc:T Epic.Tab.Release}">
                    <ScrollViewer Padding="16">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Classes="label" Text="{loc:T Epic.BuildVersionTemplate}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Selected.BuildVersionTemplate}" />
                            <TextBlock Classes="hint" Text="{}{app} {target} {kind} {artifact} {date} {time} {n}" />
                            <TextBlock Classes="hint" Text="{loc:T Epic.BuildVersionTemplate.Hint}" />

                            <TextBlock Classes="label" Text="{loc:T Epic.Label}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding Selected.Label}" Watermark="{loc:T Epic.Label.Placeholder}" />
                            <TextBlock Classes="hint" Text="{loc:T Epic.Label.Hint}" />

                            <TextBlock Classes="label" Text="{loc:T Epic.Platform}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding Selected.Platform}" Watermark="Windows" />

                            <TextBlock Classes="label" Text="{loc:T Epic.SandboxId}" Margin="0,16,0,4" />
                            <TextBox Text="{Binding Selected.SandboxId}" Watermark="{loc:T Epic.SandboxId.Placeholder}" />

                            <CheckBox Margin="0,20,0,0" Content="{loc:T Epic.PreviewToggle}" IsChecked="{Binding Selected.Preview}" />

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,20,0,0" Opacity="0.55">
                                <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T Common.AutoSaved}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Build -->
                <TabItem Header="{loc:T Tab.Build}">
                    <ScrollViewer>
                        <StackPanel Margin="20" DataContext="{Binding BuildPanel}">

                            <WrapPanel>
                                <Button Classes="accent" Margin="0,0,8,8" ToolTip.Tip="{loc:T Epic.Build.Tip}"
                                        Command="{Binding BuildCommand}" IsEnabled="{Binding CanBuild}">
                                    <c:IconLabel Symbol="CloudArrowUp" Text="{loc:T Build.Start}" />
                                </Button>
                                <Button Margin="0,0,8,8" ToolTip.Tip="{loc:T Epic.Preview.Tip}"
                                        Command="{Binding PreviewCommand}" IsEnabled="{Binding CanBuild}">
                                    <c:IconLabel Symbol="Beaker" Text="{loc:T Build.Preview}" />
                                </Button>
                                <Button Classes="subtle" Margin="0,0,8,8"
                                        AutomationProperties.Name="{loc:T Build.Cancel.Tip}"
                                        ToolTip.Tip="{loc:T Build.Cancel.Tip}"
                                        Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}">
                                    <ic:SymbolIcon Symbol="Stop" FontSize="16" />
                                </Button>
                                <Button Classes="subtle" Margin="0,0,8,8" Command="{Binding ToggleLogCommand}">
                                    <c:IconLabel Symbol="DocumentText" Text="{Binding LogToggleText}" />
                                </Button>
                                <Button Classes="subtle" Margin="0,0,8,8"
                                        AutomationProperties.Name="{loc:T Epic.ExportLog}"
                                        ToolTip.Tip="{loc:T Epic.ExportLog.Tip}"
                                        Command="{Binding ExportLogCommand}">
                                    <ic:SymbolIcon Symbol="Share" FontSize="16" />
                                </Button>
                            </WrapPanel>

                            <!-- Aşama ve ilerleme -->
                            <Border Classes="card" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Opacity="0.7" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar Margin="0,12,0,0" Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent, FallbackValue=0, Mode=OneWay}" />
                                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,10,0,0"
                                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Border>

                            <!-- Kısmi başarısızlık: yüklendi ama canlıya alınamadı -->
                            <Border Background="#33B8860B" CornerRadius="6" Padding="14" Margin="0,12,0,0"
                                    IsVisible="{Binding UploadedButNotLabelled}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <ic:SymbolIcon Symbol="Warning" FontSize="16" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" Margin="8,0,0,0" Text="{loc:T Epic.PartialFailure}" />
                                </Grid>
                            </Border>

                            <!-- Sonuç -->
                            <Border Classes="card" Padding="16" Margin="0,12,0,0"
                                    IsVisible="{Binding LastBuildSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding LastBuildSummary}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Log -->
                            <Border Classes="card" Padding="12" Margin="0,12,0,0" IsVisible="{Binding IsLogVisible}">
                                <ListBox ItemsSource="{Binding Log}" MinHeight="200" MaxHeight="420" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Classes="mono" Text="{Binding Time}" Opacity="0.45" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Text}" TextWrapping="Wrap"
                                                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Geçmiş -->
                <TabItem Header="{loc:T Tab.History}">
                    <ScrollViewer Padding="16">
                        <StackPanel DataContext="{Binding BuildPanel}">
                            <TextBlock Text="{loc:T History.Empty}" Opacity="0.6"
                                       IsVisible="{Binding History.Count, Converter={StaticResource HasNoItems}}" />

                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Padding="14" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding EpicBuildVersion}" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Opacity="0.65" Margin="0,4,0,0">
                                                    <TextBlock FontSize="12" Text="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                                    <TextBlock FontSize="12" Text=" · " />
                                                    <TextBlock FontSize="12" Text="{Binding DurationText}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Converter={StaticResource OutcomeText}}" Opacity="0.8" FontSize="12" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding FailureReason}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                           IsVisible="{Binding FailureReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                                <Button Classes="subtle" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                        ToolTip.Tip="{loc:T Epic.ExportLog.Tip}"
                                                        Command="{Binding $parent[ItemsControl].DataContext.ExportLogCommand}"
                                                        CommandParameter="{Binding}">
                                                    <c:IconLabel Symbol="Share" Text="{loc:T Epic.ExportLog}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Doğrulama -->
                <TabItem Header="{loc:T Build.Issues}">
                    <ScrollViewer Padding="16">
                        <StackPanel>
                            <TextBlock Text="{loc:T Epic.NoIssues}" Opacity="0.6" Margin="0,8,0,0" IsVisible="{Binding CanBuild}" />
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22FF6B6B" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Komut önizleme: Steam'deki script önizlemenin karşılığı -->
                <TabItem Header="{loc:T Epic.Tab.Command}">
                    <Grid RowDefinitions="Auto,*" Margin="16">
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12" Text="{loc:T Epic.Preview.Note}" />
                        <TextBox Grid.Row="1" Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Panel>
    </Grid>
</UserControl>
