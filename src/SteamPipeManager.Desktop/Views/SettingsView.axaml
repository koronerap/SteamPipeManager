<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:SteamPipeManager.Desktop.Localization"
             xmlns:c="using:SteamPipeManager.Desktop.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="SteamPipeManager.Desktop.Views.SettingsView">

    <ScrollViewer>
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="16">

            <TextBlock Classes="section" Text="{loc:T Nav.Settings}" Margin="0" />

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="{loc:T Settings.Language}" />
                    <TextBlock Classes="body" Text="{loc:T Settings.Language.Body}" />

                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              HorizontalAlignment="Left" MinWidth="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Classes="mono" Text="{Binding LanguageDirectory}" TextWrapping="Wrap" Opacity="0.6" Margin="0,12,0,0" />

                    <Button Margin="0,10,0,0" Command="{Binding OpenLanguageFolderCommand}">
                        <c:IconLabel Symbol="FolderOpen" Text="{loc:T Settings.Language.OpenFolder}" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Güncellemeler -->
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="{loc:T Settings.Updates}" />
                    <TextBlock Classes="body" Text="{loc:T Settings.Updates.Body}" />

                    <TextBlock Text="{Binding Updates.InstalledVersionText}" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="InstalledVersion" />

                    <CheckBox Margin="0,10,0,0" Content="{loc:T Settings.Updates.AutoCheck}" IsChecked="{Binding CheckForUpdates}" />

                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,0" ToolTip.Tip="{loc:T Settings.Updates.CheckNow.Tip}"
                                AutomationProperties.AutomationId="CheckForUpdatesButton"
                                Command="{Binding Updates.CheckNowCommand}">
                            <c:IconLabel Symbol="ArrowSync" Text="{loc:T Settings.Updates.CheckNow}" />
                        </Button>
                        <Button Classes="accent" ToolTip.Tip="{loc:T Update.Install.Tip}"
                                Command="{Binding Updates.InstallCommand}" IsVisible="{Binding Updates.CanInstall}">
                            <c:IconLabel Symbol="ArrowDownload" Text="{loc:T Update.Install}" />
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="{Binding Updates.StatusText}" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.85"
                               AutomationProperties.AutomationId="UpdateStatusText"
                               IsVisible="{Binding Updates.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- SteamCMD kartı yalnızca Steam'i destekleyen ürünlerde -->
            <Border Classes="card" IsVisible="{Binding SupportsSteam}">
                <StackPanel>
                    <TextBlock Classes="title" Text="{loc:T Settings.SteamCmd}" />
                    <TextBlock Classes="body" Text="{loc:T Settings.SteamCmd.Body}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding SteamCmdPath}" Watermark="{loc:T Settings.SteamCmd.Placeholder}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                AutomationProperties.Name="{loc:T Settings.SteamCmd.Pick.Tip}"
                                ToolTip.Tip="{loc:T Settings.SteamCmd.Pick.Tip}"
                                Command="{Binding BrowseSteamCmdCommand}">
                            <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button ToolTip.Tip="{loc:T Settings.SteamCmd.Verify.Tip}" Command="{Binding VerifySteamCmdCommand}">
                            <c:IconLabel Symbol="CheckmarkCircle" Text="{loc:T Settings.SteamCmd.Verify}" />
                        </Button>
                        <Button ToolTip.Tip="{loc:T Settings.SteamCmd.Download.Tip}" Command="{Binding DownloadSteamCmdCommand}"
                                IsEnabled="{Binding !IsBusy}">
                            <c:IconLabel Symbol="ArrowDownload" Text="{loc:T Settings.SteamCmd.Download}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Steam finans anahtarları: profil başına, her Steamworks şirketinin kendi anahtarı -->
            <Border Classes="card" IsVisible="{Binding SupportsSteam}">
                <StackPanel>
                    <TextBlock Classes="title" Text="{loc:T Settings.Financial}" />
                    <TextBlock Classes="body" Text="{loc:T Settings.Financial.Body}" />
                    <TextBlock Text="{Binding FinancialStorageText}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,0,0,12" />

                    <!-- İlk sürümden kalan, profile bağlı olmayan anahtar -->
                    <Border Classes="note" Margin="0,0,0,12" IsVisible="{Binding HasLegacyFinancialKey}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:T Settings.Financial.Legacy}" TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Command="{Binding DeleteLegacyFinancialKeyCommand}">
                                <c:IconLabel Symbol="Delete" Text="{loc:T Settings.Financial.RemoveLegacy}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:T Settings.Financial.NoProfiles}" Opacity="0.7" IsVisible="{Binding !HasFinancialProfiles}" />

                    <ItemsControl ItemsSource="{Binding FinancialKeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,10">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsEditing}">
                                                <Button Command="{Binding MoveLegacyCommand}"
                                                        IsVisible="{Binding $parent[UserControl].DataContext.HasLegacyFinancialKey}">
                                                    <c:IconLabel Symbol="ArrowImport" Text="{loc:T Settings.Financial.UseLegacy}" />
                                                </Button>
                                                <Button Command="{Binding EditCommand}">
                                                    <c:IconLabel Symbol="Key" Text="{Binding EditText}" />
                                                </Button>
                                                <Button Command="{Binding RemoveCommand}" IsVisible="{Binding HasKey}">
                                                    <c:IconLabel Symbol="Delete" Text="{loc:T Settings.Financial.Remove}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsEditing}">
                                            <TextBox PasswordChar="•" Text="{Binding Input}"
                                                     Watermark="{loc:T Settings.Financial.Placeholder}"
                                                     AutomationProperties.Name="{loc:T Settings.Financial.Placeholder}" />
                                            <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0"
                                                    Command="{Binding SaveCommand}" IsEnabled="{Binding !IsTesting}">
                                                <c:IconLabel Symbol="Key" Text="{loc:T Settings.Financial.Save}" />
                                            </Button>
                                            <Button Grid.Column="2" Margin="8,0,0,0" Content="{loc:T Common.Cancel}"
                                                    Command="{Binding CancelCommand}" />
                                        </Grid>

                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Opacity="0.85"
                                                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="subtle" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenFinancialGroupsPageCommand}">
                        <c:IconLabel Symbol="Open" Text="{loc:T Settings.Financial.OpenGroups}" />
                    </Button>

                    <!-- Satış tutarlarının yanında gösterilen para birimi -->
                    <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:T Settings.Currency}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" MinWidth="220"
                                          ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrency}"
                                          AutomationProperties.Name="{loc:T Settings.Currency}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{loc:T Settings.Currency.Hint}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                    </Border>

                    <!-- Telefona aktar: Android'deki Pipe Manager Pulse için QR ve kod -->
                    <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:T Settings.Phone}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding ShowPairingCommand}" IsVisible="{Binding !IsPairingVisible}">
                                    <c:IconLabel Symbol="QrCode" Text="{loc:T Settings.Phone.Show}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{loc:T Settings.Phone.Body}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                            <TextBlock Text="{loc:T Settings.Phone.Preparing}" FontSize="12" Opacity="0.7" IsVisible="{Binding IsPreparingPairing}" />

                            <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0" IsVisible="{Binding IsPairingVisible}">
                                <c:QrCodeView Width="260" Height="260" Modules="{Binding PairingModules}" />
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{loc:T Settings.Phone.Code}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding PairingCode}" FontSize="30" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
                                    <TextBlock Text="{Binding PairingSummary}" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="CopyPairingText">
                                            <c:IconLabel Symbol="Copy" Text="{loc:T Settings.Phone.Copy}" />
                                        </Button>
                                        <Button Command="{Binding HidePairingCommand}">
                                            <c:IconLabel Symbol="EyeOff" Text="{loc:T Settings.Phone.Hide}" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- BuildPatchTool: Epic tarafının aracı; indirme seçeneği yok -->
            <Border Classes="card" IsVisible="{Binding SupportsEpic}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <TextBlock Text="{loc:T Epic.Tool}" FontWeight="SemiBold" FontSize="16" />
                        <Border Background="#33B8860B" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Epic.ExperimentalBadge}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <TextBlock Classes="body" Text="{loc:T Epic.Tool.Body}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding BuildPatchToolPath}" Watermark="{loc:T Epic.Tool.Placeholder}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                AutomationProperties.Name="{loc:T Epic.Tool.Pick.Tip}"
                                ToolTip.Tip="{loc:T Epic.Tool.Pick.Tip}"
                                Command="{Binding BrowseBuildPatchToolCommand}">
                            <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                        </Button>
                    </Grid>

                    <Button Margin="0,12,0,0" HorizontalAlignment="Left" ToolTip.Tip="{loc:T Epic.Tool.Verify.Tip}"
                            Command="{Binding VerifyBuildPatchToolCommand}">
                        <c:IconLabel Symbol="CheckmarkCircle" Text="{loc:T Settings.SteamCmd.Verify}" />
                    </Button>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="{loc:T Settings.Timeouts}" />
                    <TextBlock Classes="body" Text="{loc:T Settings.Timeouts.Body}" />

                    <TextBlock Classes="label" Text="{loc:T Settings.StallSeconds}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding StallWarningSeconds}" />
                    <TextBlock Classes="hint" Text="{loc:T Settings.StallSeconds.Hint}" />

                    <TextBlock Classes="label" Text="{loc:T Settings.SessionTimeout}" />
                    <TextBox Text="{Binding SessionCheckTimeoutSeconds}" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel>
                    <TextBlock Classes="title" Text="{loc:T Settings.DataLocation}" Margin="0,0,0,8" />
                    <TextBlock Classes="mono" Text="{Binding WorkspaceRoot}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,8,0,0" Text="{loc:T Settings.DataLocation.Body}" />
                    <Button Margin="0,12,0,0" HorizontalAlignment="Left" ToolTip.Tip="{loc:T Settings.OpenFolder.Tip}"
                            Command="{Binding OpenWorkspaceFolderCommand}">
                        <c:IconLabel Symbol="FolderOpen" Text="{loc:T Settings.OpenFolder}" />
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="accent" ToolTip.Tip="{loc:T Settings.Save.Tip}" Command="{Binding SaveCommand}">
                    <c:IconLabel Symbol="Save" Text="{loc:T Common.Save}" />
                </Button>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Opacity="0.85" TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
