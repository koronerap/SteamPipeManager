<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SteamPipeManager.Desktop.Widget.WidgetApp"
             RequestedThemeVariant="Dark">

    <!-- Ana uygulamayla aynı tema ve dönüştürücüler. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <StyleInclude Source="/Themes/AppStyles.axaml" />
    </Application.Styles>
</Application>
