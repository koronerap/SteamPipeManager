<UserControl x:Class="SteamPipeManager.App.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:SteamPipeManager.App.Localization">

    <UserControl.Resources>
        <!-- Küçük çubuk grafik: değerler görünüm modelinde 0..1'e çekiliyor. -->
        <ItemsPanelTemplate x:Key="BarsPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="PlayerBar">
            <Border VerticalAlignment="Bottom" Margin="0.5,0" CornerRadius="1" Background="#B34C9AFF"
                    Height="{Binding Converter={StaticResource FractionToHeight}, ConverterParameter=36}" />
        </DataTemplate>

        <DataTemplate x:Key="WishlistBar">
            <Border VerticalAlignment="Bottom" Margin="0.5,0" CornerRadius="1" Background="#B3E06C9F"
                    Height="{Binding Converter={StaticResource FractionToHeight}, ConverterParameter=36}" />
        </DataTemplate>

        <DataTemplate x:Key="SalesBar">
            <Border VerticalAlignment="Bottom" Margin="0.5,0" CornerRadius="1" Background="#B33FB950"
                    Height="{Binding Converter={StaticResource FractionToHeight}, ConverterParameter=36}" />
        </DataTemplate>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="StatDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Başlık ve yenile -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:T Nav.Analytics}" Style="{StaticResource SectionHeader}" Margin="0" />
                <TextBlock Text="{Binding UpdatedText}" FontSize="12" Opacity="0.6" Margin="0,2,0,0"
                           Visibility="{Binding UpdatedText, Converter={StaticResource TextToVis}}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:Button Padding="14,8" Margin="0,0,8,0"
                           Icon="{ui:SymbolIcon DesktopPulse24}"
                           Content="{loc:T Analytics.OpenWidget}"
                           ToolTip="{loc:T Analytics.OpenWidget.Tip}"
                           Command="{Binding OpenWidgetCommand}"
                           Visibility="{Binding CanOpenWidget, Converter={StaticResource BoolToVis}}" />
                <ui:Button Padding="14,8"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Content="{loc:T Analytics.Refresh}"
                           Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Anahtar yok / reddedildi / geçmiş iniyor -->
        <Border Grid.Row="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderThickness="1"
                Background="#14FFFFFF"
                BorderBrush="{Binding NoticeTone, Converter={StaticResource ToneBrush}}"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />

                <ui:Button Grid.Column="1" Margin="12,0,0,0" Padding="12,6"
                           Icon="{ui:SymbolIcon Key24}"
                           Content="{loc:T Analytics.AddKey}"
                           Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           Visibility="{Binding HasKey, Converter={StaticResource BoolToVisInverted}}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{loc:T Analytics.Empty}" Opacity="0.6" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center"
                   Visibility="{Binding HasCards, Converter={StaticResource BoolToVisInverted}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasCards, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Kütüphane kapsülü; yoksa baş harf -->
                                <Border Width="64" Height="96" CornerRadius="6" VerticalAlignment="Top" Background="#2A2F6FEB">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="SemiBold" Opacity="0.7"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="6"
                                                Visibility="{Binding HasCapsule, Converter={StaticResource BoolToVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding CapsulePath, Converter={StaticResource PathToImage}}"
                                                            Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.6" />
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Anlık oyuncu -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:T Analytics.Players}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding PlayersText}" Style="{StaticResource StatValue}" />
                                            <TextBlock Text="{Binding PlayersDetail}" Style="{StaticResource StatDetail}" />
                                            <ItemsControl ItemsSource="{Binding PlayersSeries}" Height="36" Margin="0,8,0,0"
                                                          ItemsPanel="{StaticResource BarsPanel}"
                                                          ItemTemplate="{StaticResource PlayerBar}" />
                                        </StackPanel>

                                        <!-- Wishlist -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:T Analytics.Wishlists}" Style="{StaticResource StatLabel}" />
                                            <StackPanel Visibility="{Binding HasWishlist, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding WishlistText}" Style="{StaticResource StatValue}" />
                                                <TextBlock Text="{Binding WishlistDetail}" Style="{StaticResource StatDetail}" />
                                                <ItemsControl ItemsSource="{Binding WishlistSeries}" Height="36" Margin="0,8,0,0"
                                                              ItemsPanel="{StaticResource BarsPanel}"
                                                              ItemTemplate="{StaticResource WishlistBar}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding HasWishlist, Converter={StaticResource BoolToVisInverted}}">
                                                <TextBlock Text="—" Style="{StaticResource StatValue}" Opacity="0.5" />
                                                <TextBlock Text="{Binding FinancialPlaceholder}" Style="{StaticResource StatDetail}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Satışlar -->
                                        <StackPanel Grid.Column="4">
                                            <!-- Gelirin neyi gösterdiği: iade ve vergi düşülmüş, Steam payı düşülmemiş -->
                                            <TextBlock Text="{loc:T Analytics.SalesToday}" Style="{StaticResource StatLabel}"
                                                       ToolTip="{loc:T Analytics.SalesNote}" />
                                            <StackPanel Visibility="{Binding HasSales, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding SalesTodayText}" Style="{StaticResource StatValue}" />
                                                <TextBlock Text="{Binding SalesTodayDetail}" Style="{StaticResource StatDetail}" />
                                                <ItemsControl ItemsSource="{Binding SalesRows}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.6" Margin="0,0,8,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding SalesSeries}" Height="36" Margin="0,8,0,0"
                                                              ItemsPanel="{StaticResource BarsPanel}"
                                                              ItemTemplate="{StaticResource SalesBar}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding HasSales, Converter={StaticResource BoolToVisInverted}}">
                                                <TextBlock Text="—" Style="{StaticResource StatValue}" Opacity="0.5" />
                                                <TextBlock Text="{Binding FinancialPlaceholder}" Style="{StaticResource StatDetail}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
