<UserControl x:Class="SteamPipeManager.App.Views.AppPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:SteamPipeManager.App.Localization">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:T Apps.Title}" Style="{StaticResource SectionHeader}" Margin="0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:Button Padding="14,8"
                           Icon="{ui:SymbolIcon FolderArrowRight24}"
                           Visibility="{Binding IsSteamProfile, Converter={StaticResource BoolToVis}}"
                       AutomationProperties.Name="{loc:T Apps.Import.Tip}"
                                   ToolTip="{loc:T Apps.Import.Tip}"
                           Command="{Binding BeginImportCommand}" />
                <ui:Button Appearance="Primary" Margin="8,0,0,0" Padding="14,8"
                           Icon="{ui:SymbolIcon Add24}"
                           AutomationProperties.Name="{loc:T Apps.New.Tip}"
                                   ToolTip="{loc:T Apps.New.Tip}"
                           Command="{Binding AddAppCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Oyun adını düzenleme -->
                <ui:Card Padding="20" Margin="0,0,0,16" MaxWidth="480" HorizontalAlignment="Left"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Apps.Edit.Title}" FontWeight="SemiBold" FontSize="16"
                                   Margin="0,0,0,12" />

                        <ui:TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button Appearance="Primary" Padding="16,6"
                                       Icon="{ui:SymbolIcon Save24}"
                                       Content="{loc:T Common.Save}"
                                       Command="{Binding ConfirmEditCommand}" />
                            <ui:Button Appearance="Transparent" Margin="8,0,0,0"
                                       Content="{loc:T Common.Cancel}"
                                       Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- İçe aktarma paneli -->
                <ui:Card Padding="20" Margin="0,0,0,16"
                         Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Import.Title}"
                                   FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                                   Text="{loc:T Import.Body}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding ImportPath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="D:\SteamPipe (Pixel Racer)" />

                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       AutomationProperties.Name="{loc:T Common.PickFolder}"
                                   ToolTip="{loc:T Common.PickFolder}"
                                       Command="{Binding BrowseImportPathCommand}" />
                            <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="10,8"
                                       Icon="{ui:SymbolIcon Search24}"
                                       AutomationProperties.Name="{loc:T Import.Scan.Tip}"
                                   ToolTip="{loc:T Import.Scan.Tip}"
                                       Command="{Binding ScanImportPathCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" Opacity="0.85"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}" />

                        <ItemsControl ItemsSource="{Binding ImportCandidates}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#22FFFFFF" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Top" Margin="0,2,8,0" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding SubApp.Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Opacity="0.7" FontSize="12" />
                                                <TextBlock Text="{Binding SourceFile}" Opacity="0.5" FontSize="11" />
                                                <TextBlock Text="{Binding WarningText}"
                                                           Foreground="Goldenrod" FontSize="12" TextWrapping="Wrap"
                                                           Visibility="{Binding WarningText, Converter={StaticResource TextToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button Content="{loc:T Import.Confirm}" Appearance="Primary"
                                       Command="{Binding ConfirmImportCommand}"
                                       Visibility="{Binding ImportCandidates.Count, Converter={StaticResource CountToVis}}" />
                            <ui:Button Content="{loc:T Common.Cancel}" Appearance="Transparent" Margin="8,0,0,0"
                                       Command="{Binding CancelImportCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Boş durum -->
                <ui:Card Padding="24" Margin="0,0,0,16" MaxWidth="620" HorizontalAlignment="Left"
                         Visibility="{Binding Cards.Count, Converter={StaticResource CountToVisInverted}}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Apps.Empty.Title}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                   Text="{loc:T Apps.Empty.Body}"
                                   Visibility="{Binding IsSteamProfile, Converter={StaticResource BoolToVis}}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                   Text="{loc:T Apps.Empty.Body.Epic}"
                                   Visibility="{Binding IsSteamProfile, Converter={StaticResource BoolToVisInverted}}" />
                    </StackPanel>
                </ui:Card>

                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Width="220" Margin="0,0,18,18" Padding="0">
                                <StackPanel>
                                    <!-- Steam dikey kütüphane kapsülü (2:3); yoksa yer tutucu -->
                                    <Grid Height="300">
                                        <Border CornerRadius="6,6,0,0"
                                                Visibility="{Binding HasCapsule, Converter={StaticResource BoolToVisInverted}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2A3B5C" Offset="0" />
                                                    <GradientStop Color="#16203A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="52" FontWeight="Light"
                                                           Opacity="0.5" HorizontalAlignment="Center" />
                                                <TextBlock Text="{loc:T Common.NoImage}" FontSize="10" Opacity="0.35"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border CornerRadius="6,6,0,0"
                                                Visibility="{Binding HasCapsule, Converter={StaticResource BoolToVis}}">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill"
                                                            ImageSource="{Binding CapsulePath, Converter={StaticResource PathToImage}}" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <StackPanel Margin="14,12,14,14">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding Summary}"
                                                   Opacity="0.65" Margin="0,3,0,0" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:Button Grid.Column="0" Appearance="Primary" Padding="14,6"
                                                       Icon="{ui:SymbolIcon Settings24}"
                                                       Content="{loc:T Apps.Manage}"
                                                       ToolTip="{loc:T Apps.Manage.Tip}"
                                                       HorizontalAlignment="Stretch"
                                                       Command="{Binding DataContext.SelectCommand,
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />

                                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="8,6"
                                                       Icon="{ui:SymbolIcon Edit24}"
                                                       AutomationProperties.Name="{loc:T Apps.Edit.Tip}"
                                                       ToolTip="{loc:T Apps.Edit.Tip}"
                                                       Command="{Binding DataContext.BeginEditCommand,
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />

                                            <ui:Button Grid.Column="2" Margin="6,0,0,0" Padding="8,6"
                                                       Appearance="Transparent"
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       AutomationProperties.Name="{loc:T Apps.Delete.Tip}"
                                                       ToolTip="{loc:T Apps.Delete.Tip}"
                                                       Command="{Binding DataContext.DeleteCommand,
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
