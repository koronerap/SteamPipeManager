<UserControl x:Class="SteamPipeManager.App.Views.EpicWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:SteamPipeManager.App.Localization"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: hedef listesi -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:T Epic.Artifacts}" FontWeight="SemiBold"
                       Opacity="0.7" Margin="0,0,0,10" />

            <ListBox Grid.Row="1" ItemsSource="{Binding Artifacts}"
                     SelectedItem="{Binding SelectedCard}"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="6"
                                    Background="#2F6FEB">
                                <TextBlock Text="{Binding Initial}" Foreground="White"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Hızlı build: hedefi seçip Build sekmesine geçerek başlatır. -->
                            <ui:Button Grid.Column="2" Padding="6,4" Appearance="Transparent"
                                       VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon CloudArrowUp24}"
                                       AutomationProperties.Name="{loc:T Apps.QuickBuild.Tip}"
                                       ToolTip="{loc:T Apps.QuickBuild.Tip}"
                                       Command="{Binding DataContext.QuickBuildCommand,
                                                 RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />

                            <ui:Button Grid.Column="3" Padding="6,4" Appearance="Transparent"
                                       VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       AutomationProperties.Name="{loc:T Epic.Delete.Tip}"
                                       ToolTip="{loc:T Epic.Delete.Tip}"
                                       Command="{Binding DataContext.DeleteArtifactCommand,
                                                 RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ui:Button Grid.Row="2" Margin="0,10,0,0" Padding="12,7"
                       HorizontalAlignment="Stretch"
                       Icon="{ui:SymbolIcon Add24}"
                       Content="{loc:T Epic.AddArtifact}"
                       ToolTip="{loc:T Epic.AddArtifact.Tip}"
                       Command="{Binding AddArtifactCommand}" />
        </Grid>

        <!-- Sağ: seçili hedefin ayarları -->
        <Grid Grid.Column="1">
            <TextBlock Text="{loc:T Epic.SelectPrompt}"
                       Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInverted}}" />

            <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">

                <TabItem Header="{loc:T Tab.General}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                            <TextBlock Text="{loc:T Epic.ProductId}" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{loc:T Epic.ProductId.Hint}" />

                            <TextBlock Text="{loc:T General.Title}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <ui:TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{loc:T General.Kind}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Selected.Kind}" />

                            <TextBlock Text="{loc:T Epic.ArtifactId}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <ui:TextBox Text="{Binding Selected.ArtifactId, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{loc:T Epic.BuildRoot}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding Selected.BuildRoot, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           AutomationProperties.Name="{loc:T Common.PickFolder}"
                                           ToolTip="{loc:T Common.PickFolder}"
                                           Command="{Binding BrowseBuildRootCommand}" />
                            </Grid>
                            <TextBlock Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{loc:T Epic.BuildRoot.Hint}" />

                            <TextBlock Text="{loc:T Epic.AppLaunch}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <ui:TextBox Text="{Binding Selected.AppLaunch, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Game.exe" />

                            <TextBlock Text="{loc:T Epic.AppArgs}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <ui:TextBox Text="{Binding Selected.AppArgs, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{loc:T Epic.CloudDir}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding Selected.CloudDir, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:T Epic.CloudDir.Placeholder}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           AutomationProperties.Name="{loc:T Common.PickFolder}"
                                           ToolTip="{loc:T Common.PickFolder}"
                                           Command="{Binding BrowseCloudDirCommand}" />
                            </Grid>
                            <TextBlock Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{loc:T Epic.CloudDir.Hint}" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Opacity="0.55">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T Common.AutoSaved}" Margin="6,0,0,0"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Yayın: Epic'te canlıya alma ayrı bir çağrı olduğu için ayrı sekme -->
                <TabItem Header="{loc:T Epic.Tab.Release}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                            <TextBlock Text="{loc:T Epic.BuildVersionTemplate}" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding Selected.BuildVersionTemplate, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Opacity="0.5" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{}{app} {target} {kind} {artifact} {date} {time} {n}" />
                            <TextBlock Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{loc:T Epic.BuildVersionTemplate.Hint}" />

                            <TextBlock Text="{loc:T Epic.Label}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <ui:TextBox Text="{Binding Selected.Label, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{loc:T Epic.Label.Placeholder}" />
                            <TextBlock Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{loc:T Epic.Label.Hint}" />

                            <TextBlock Text="{loc:T Epic.Platform}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <ui:TextBox Text="{Binding Selected.Platform, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Windows" />

                            <TextBlock Text="{loc:T Epic.SandboxId}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <ui:TextBox Text="{Binding Selected.SandboxId, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{loc:T Epic.SandboxId.Placeholder}" />

                            <CheckBox Margin="0,20,0,0"
                                      Content="{loc:T Epic.PreviewToggle}"
                                      IsChecked="{Binding Selected.Preview}" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Opacity="0.55">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T Common.AutoSaved}" Margin="6,0,0,0"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Build -->
                <TabItem Header="{loc:T Tab.Build}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" DataContext="{Binding BuildPanel}">

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Primary" Padding="16,7"
                                           Icon="{ui:SymbolIcon CloudArrowUp24}"
                                           Content="{loc:T Build.Start}"
                                           ToolTip="{loc:T Epic.Build.Tip}"
                                           Command="{Binding BuildCommand}"
                                           IsEnabled="{Binding CanBuild}" />

                                <ui:Button Margin="8,0,0,0" Padding="16,7"
                                           Icon="{ui:SymbolIcon Beaker24}"
                                           Content="{loc:T Build.Preview}"
                                           ToolTip="{loc:T Epic.Preview.Tip}"
                                           Command="{Binding PreviewCommand}"
                                           IsEnabled="{Binding CanBuild}" />

                                <ui:Button Margin="8,0,0,0" Padding="12,7"
                                           Appearance="Transparent"
                                           Icon="{ui:SymbolIcon Stop24}"
                                           AutomationProperties.Name="{loc:T Build.Cancel.Tip}"
                                           ToolTip="{loc:T Build.Cancel.Tip}"
                                           Command="{Binding CancelCommand}"
                                           IsEnabled="{Binding CanCancel}" />

                                <ui:Button Margin="8,0,0,0" Padding="12,7"
                                           Appearance="Transparent"
                                           Icon="{ui:SymbolIcon DocumentText24}"
                                           Content="{Binding LogToggleText}"
                                           Command="{Binding ToggleLogCommand}" />

                                <ui:Button Margin="8,0,0,0" Padding="12,7"
                                           Appearance="Transparent"
                                           Icon="{ui:SymbolIcon Share24}"
                                           AutomationProperties.Name="{loc:T Epic.ExportLog}"
                                           ToolTip="{loc:T Epic.ExportLog.Tip}"
                                           Command="{Binding ExportLogCommand}" />
                            </StackPanel>

                            <!-- Asama ve ilerleme -->
                            <ui:Card Padding="20" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding PhaseText}"
                                                   FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                                   Opacity="0.7" VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar Margin="0,12,0,0" Height="6"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent, FallbackValue=0}" />

                                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                               Opacity="0.75" FontSize="12" Margin="0,10,0,0"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}" />
                                </StackPanel>
                            </ui:Card>

                            <!-- Kismi basarisizlik: yuklendi ama canliya alinamadi -->
                            <Border Background="#33B8860B" CornerRadius="6" Padding="14" Margin="0,12,0,0"
                                    Visibility="{Binding UploadedButNotLabelled, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="16"
                                                   VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12" Margin="8,0,0,0"
                                               Text="{loc:T Epic.PartialFailure}" />
                                </Grid>
                            </Border>

                            <!-- Sonuc -->
                            <ui:Card Padding="16" Margin="0,12,0,0"
                                     Visibility="{Binding LastBuildSummary, Converter={StaticResource TextToVis}}">
                                <TextBlock Text="{Binding LastBuildSummary}" TextWrapping="Wrap" />
                            </ui:Card>

                            <!-- Log -->
                            <ui:Card Padding="12" Margin="0,12,0,0"
                                     Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
                                <ListBox ItemsSource="{Binding Log}" MinHeight="200" MaxHeight="420"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Time}" Opacity="0.45"
                                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                                           FontSize="11" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}"
                                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                                           FontSize="11" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Gecmis -->
                <TabItem Header="{loc:T Tab.History}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel DataContext="{Binding BuildPanel}">
                            <TextBlock Text="{loc:T History.Empty}" Opacity="0.6"
                                       Visibility="{Binding History.Count, Converter={StaticResource CountToVisInverted}}" />

                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Padding="14" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding EpicBuildVersion}" FontWeight="SemiBold" />
                                                <TextBlock Opacity="0.65" FontSize="12" Margin="0,4,0,0">
                                                    <Run Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, Mode=OneWay}" />
                                                    <Run Text=" - " />
                                                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Converter={StaticResource OutcomeText}}"
                                                           Opacity="0.8" FontSize="12" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding FailureReason}" Opacity="0.8" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                                           Visibility="{Binding FailureReason, Converter={StaticResource TextToVis}}" />

                                                <ui:Button Margin="0,10,0,0" Padding="10,5"
                                                           HorizontalAlignment="Left"
                                                           Appearance="Transparent"
                                                           Icon="{ui:SymbolIcon Share24}"
                                                           Content="{loc:T Epic.ExportLog}"
                                                           ToolTip="{loc:T Epic.ExportLog.Tip}"
                                                           Command="{Binding DataContext.ExportLogCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Doğrulama -->
                <TabItem Header="{loc:T Build.Issues}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{loc:T Epic.NoIssues}" Opacity="0.6" Margin="0,8,0,0"
                                       Visibility="{Binding CanBuild, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22FF6B6B" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Komut önizleme: Steam'deki script önizlemenin karşılığı -->
                <TabItem Header="{loc:T Epic.Tab.Command}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"
                                   Text="{loc:T Epic.Preview.Note}" />

                        <ui:TextBox Grid.Row="1"
                                    Text="{Binding CommandPreview, Mode=OneWay}"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    FontFamily="Cascadia Mono, Consolas, monospace"
                                    FontSize="12" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
