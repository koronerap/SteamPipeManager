<UserControl x:Class="SteamPipeManager.App.Views.SubAppWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:SteamPipeManager.App.Localization"
             xmlns:models="clr-namespace:SteamPipeManager.Core.Models;assembly=SteamPipeManager.Core"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="SubAppKinds" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SubAppKind" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: build hedefleri -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:T Workspace.Targets}" Style="{StaticResource SectionHeader}" FontSize="15" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding SubApps}"
                     SelectedItem="{Binding SelectedCard}"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Her yan uygulamanın kendi Steam kapsülü -->
                            <Grid Grid.Column="0" Width="34" Height="51" VerticalAlignment="Center">
                                <Border CornerRadius="3" Background="#2A3B5C"
                                        Visibility="{Binding HasCapsule, Converter={StaticResource BoolToVisInverted}}">
                                    <TextBlock Text="{Binding Initial}" FontSize="15" Opacity="0.6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <Border CornerRadius="3"
                                        Visibility="{Binding HasCapsule, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding CapsulePath, Converter={StaticResource PathToImage}}" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Hızlı build: hedefi seçip Build sekmesine geçerek başlatır. -->
                            <ui:Button Grid.Column="2" Padding="6,4" Appearance="Transparent"
                                       VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon CloudArrowUp24}"
                                       AutomationProperties.Name="{loc:T Apps.QuickBuild.Tip}"
                                       ToolTip="{loc:T Apps.QuickBuild.Tip}"
                                       Command="{Binding DataContext.QuickBuildCommand,
                                                 RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />

                            <ui:Button Grid.Column="3" Padding="6,4" Appearance="Transparent"
                                       VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       AutomationProperties.Name="{loc:T Workspace.Delete.Tip}"
                                       ToolTip="{loc:T Workspace.Delete.Tip}"
                                       Command="{Binding DataContext.DeleteSubAppCommand,
                                                 RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ui:Button Grid.Row="2" Margin="0,8,0,0" Padding="10,8"
                       HorizontalAlignment="Stretch"
                       Icon="{ui:SymbolIcon Add24}"
                       Content="{loc:T Workspace.AddSubApp}"
ToolTip="{loc:T Workspace.AddSubApp.Tip}"
                       Command="{Binding AddSubAppCommand}" />
        </Grid>

        <!-- Sağ: seçili hedefin ayarları -->
        <Grid Grid.Column="1">
            <TextBlock Text="{loc:T Workspace.SelectPrompt}"
                       Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInverted}}" />

            <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">

                <TabItem Header="{loc:T Tab.General}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                            <TextBlock Text="{loc:T General.Title}" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{loc:T General.Kind}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource SubAppKinds}}"
                                      SelectedItem="{Binding Selected.Kind}" />

                            <TextBlock Text="{loc:T General.AppId}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                            <ui:TextBox Text="{Binding Selected.SteamAppId, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{loc:T General.SharedContent}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding Selected.ContentRoot, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="{loc:T General.SharedContent.Hint}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           AutomationProperties.Name="{loc:T Common.PickFolder}"
                                   ToolTip="{loc:T Common.PickFolder}"
                                           Command="{Binding BrowseSubAppContentCommand}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Opacity="0.55">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T Common.AutoSaved}" Margin="6,0,0,0"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" Margin="0,8,0,0"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:T Tab.Depots}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Selected.Depots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Margin="0,0,0,12" Padding="16">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{loc:T Depot.Id}" Style="{StaticResource FieldLabel}" />
                                                        <ui:TextBox Text="{Binding DepotId, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                        <TextBlock Text="{loc:T Depot.Label}" Style="{StaticResource FieldLabel}" />
                                                        <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                    PlaceholderText="Windows" />
                                                    </StackPanel>

                                                    <ui:Button Grid.Column="2" Padding="9,7"
                                                               Appearance="Transparent" VerticalAlignment="Bottom"
                                                               Icon="{ui:SymbolIcon Delete24}"
                                                               AutomationProperties.Name="{loc:T Depot.Remove.Tip}"
                                   ToolTip="{loc:T Depot.Remove.Tip}"
                                                               Command="{Binding DataContext.RemoveDepotCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />
                                                </Grid>

                                                <TextBlock Text="{loc:T Depot.ContentRoot}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox Grid.Column="0"
                                                                Text="{Binding ContentRoot, UpdateSourceTrigger=PropertyChanged}"
                                                                PlaceholderText="D:\Builds\Oyun\Windows" />
                                                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                                               AutomationProperties.Name="{loc:T Depot.PickContent.Tip}"
                                   ToolTip="{loc:T Depot.PickContent.Tip}"
                                                               Command="{Binding DataContext.BrowseDepotContentCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />
                                                </Grid>
                                            </StackPanel>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal">
                                <ui:Button Padding="14,7"
                                           Icon="{ui:SymbolIcon Add24}"
                                           Content="{loc:T Depot.Add}"
ToolTip="{loc:T Depot.Add.Tip}"
                                           Command="{Binding AddDepotCommand}" />
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Opacity="0.55"
                                            VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:T Common.AutoSaved}" Margin="6,0,0,0"
                                               FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:T Tab.Build}">
                    <!-- İçerik pencereye sığmadığında kaydırılabilmeli: build sonrası
                         sonuç kartı ekranın altında kalıp erişilemiyordu. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20" DataContext="{Binding BuildPanel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Eylemler -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <ui:Button Appearance="Primary" Padding="22,10" FontWeight="SemiBold"
                                       Icon="{ui:SymbolIcon CloudArrowUp24}"
                                       Content="{loc:T Build.Start}"
ToolTip="{loc:T Build.Start.Tip}"
                                       Command="{Binding BuildCommand}"
                                       IsEnabled="{Binding CanBuild}" />
                            <ui:Button Margin="10,0,0,0" Padding="16,10"
                                       Icon="{ui:SymbolIcon Eye24}"
                                       Content="{loc:T Build.Preview}"
ToolTip="{loc:T Build.Preview.Tip}"
                                       Command="{Binding PreviewCommand}"
                                       IsEnabled="{Binding CanBuild}" />
                            <ui:Button Margin="10,0,0,0" Padding="12,10"
                                       Appearance="Danger"
                                       Icon="{ui:SymbolIcon Stop24}"
                                       AutomationProperties.Name="{loc:T Build.Cancel.Tip}"
                                   ToolTip="{loc:T Build.Cancel.Tip}"
                                       Command="{Binding CancelCommand}"
                                       IsEnabled="{Binding CanCancel}" />
                        </StackPanel>

                        <!-- Log her zaman açılabilmeli, ilk build'den önce de -->
                        <ui:Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Appearance="Transparent" Padding="10,6"
                                   Icon="{ui:SymbolIcon DocumentText24}"
                                   AutomationProperties.Name="{Binding LogToggleText}"
                                   ToolTip="{Binding LogToggleText}"
                                   Command="{Binding ToggleLogCommand}" />

                        <!-- Doğrulama sorunları: build i engelleyen şeyler burada, ayrı sekmede değil -->
                        <ui:Card Grid.Row="0" Padding="16" Margin="0,52,0,16"
                                 DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Visibility="{Binding Issues.Count, Converter={StaticResource CountToVis}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T Build.Issues}" FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,10,0"
                                                         Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>

                        <!-- Bu build hedefine özgü ayarlar: açıklama, branch, preview -->
                        <ui:Card Grid.Row="1" Padding="20" Margin="0,0,0,16"
                                 DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Visibility="{Binding BuildPanel.IsBusy, Converter={StaticResource BoolToVisInverted}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T Build.Settings}" FontWeight="SemiBold" FontSize="13"
                                           Opacity="0.7" Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:T Build.Description}" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding Selected.BuildDescriptionTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Opacity="0.5" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="{}{app} {subapp} {kind} {appid} {branch} {user} {date} {time}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:T Build.Branch}" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding Selected.SetLiveBranch, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{loc:T Build.Branch.Hint}" />
                                        <TextBlock Opacity="0.5" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="{loc:T Build.Branch.Note}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <CheckBox VerticalAlignment="Center"
                                              Content="{loc:T Build.PreviewToggle}"
                                              IsChecked="{Binding Selected.Preview}" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Opacity="0.55" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:T Common.AutoSaved}" Margin="6,0,0,0"
                                                   FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Aşama ve ilerleme: ham log yerine bu gösteriliyor -->
                        <ui:Card Grid.Row="2" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding PhaseText}"
                                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="17" Opacity="0.75"
                                               Text="{Binding ProgressText}" />
                                </Grid>

                                <ProgressBar Height="6" Minimum="0" Maximum="100" Margin="0,14,0,0"
                                             Value="{Binding ProgressPercent, FallbackValue=0, Mode=OneWay}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" Opacity="0.7"
                                           FontSize="12" TextWrapping="Wrap"
                                           Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}" />

                                <!-- Ne build edileceğinin özeti: butona basmadan önce görünür -->
                                <ItemsControl ItemsSource="{Binding TargetSummary}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Opacity="0.55" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Canlıya alma geri alınamaz; önceden uyarılır -->
                                <Border Background="#33B8860B" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                                        Visibility="{Binding GoesLive, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="Goldenrod"
                                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <!-- Tek metin: cümle yapısı dile göre değişiyor, parçalı Run'lar çeviriyi kırardı. -->
                                        <TextBlock Text="{Binding GoesLiveText}"
                                                   FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ui:Card>

                        <!-- Sonuç -->
                        <ui:Card Grid.Row="3" Padding="18" Margin="0,0,0,16"
                                 Visibility="{Binding LastBuildSummary, Converter={StaticResource TextToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:T Common.Result}" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                    <TextBlock Text="{Binding LastBuildSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- Ham log: varsayılan gizli, hata olunca otomatik açılıyor -->
                        <Border Grid.Row="4" Background="#22000000" CornerRadius="6" Padding="10"
                                MinHeight="200" MaxHeight="420"
                                Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
                            <ListBox ItemsSource="{Binding Log}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,1" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Time}" Opacity="0.4" Margin="0,0,10,0"
                                                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Log kapalıyken alt boşluğu bir ipucu dolduruyor -->
                        <TextBlock Grid.Row="4" VerticalAlignment="Top" Opacity="0.45" FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{loc:T Build.LogHidden}"
                                   Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisInverted}}" />
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:T Tab.History}">
                    <Grid Margin="16" DataContext="{Binding BuildPanel}">
                        <TextBlock Text="{loc:T History.Empty}"
                                   Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding History.Count, Converter={StaticResource CountToVisInverted}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding History.Count, Converter={StaticResource CountToVis}}">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Margin="0,0,0,8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Converter={StaticResource OutcomeText}}" FontWeight="SemiBold" />
                                                        <TextBlock Text=" · " Opacity="0.5" />
                                                        <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                                   Opacity="0.75" />
                                                        <TextBlock Text=" · " Opacity="0.5" />
                                                        <TextBlock Text="{Binding DurationText}" Opacity="0.75" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" Opacity="0.8" Margin="0,4,0,0"
                                                               TextWrapping="Wrap" />

                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.6">
                                                        <TextBlock Text="{loc:T History.BuildId}" FontSize="11" />
                                                        <TextBlock Text="{Binding SteamBuildId, TargetNullValue='—'}" FontSize="11" />
                                                        <TextBlock Text="{loc:T History.Branch}" FontSize="11" />
                                                        <TextBlock Text="{Binding SetLiveBranch, TargetNullValue='—'}" FontSize="11" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding FailureReason}" Foreground="IndianRed"
                                                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding FailureReason, Converter={StaticResource TextToVis}}" />
                                                </StackPanel>

                                                <ui:Button Grid.Column="1" Padding="9,7" Appearance="Transparent"
                                                           VerticalAlignment="Center"
                                                           Icon="{ui:SymbolIcon DocumentSearch24}"
                                                           AutomationProperties.Name="{loc:T History.OpenLog.Tip}"
                                   ToolTip="{loc:T History.OpenLog.Tip}"
                                                           Command="{Binding DataContext.OpenLogFolderCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:T Tab.ScriptPreview}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"
                                   Text="{loc:T Preview.Note}" />

                        <Border Grid.Row="1" Background="#18000000" CornerRadius="6" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ScriptPreview, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Cascadia Mono, Consolas, monospace"
                                         FontSize="12" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</UserControl>
