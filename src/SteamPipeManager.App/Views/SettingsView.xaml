<UserControl x:Class="SteamPipeManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:SteamPipeManager.App.Localization"
             xmlns:controls="clr-namespace:SteamPipeManager.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{loc:T Nav.Settings}" Style="{StaticResource SectionHeader}" />

            <ui:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings.Language}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T Settings.Language.Body}"
                               TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12" />

                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Name"
                              HorizontalAlignment="Left" MinWidth="220" />

                    <TextBlock Text="{Binding LanguageDirectory}" TextWrapping="Wrap" Opacity="0.6"
                               FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                               Margin="0,12,0,0" />

                    <ui:Button Margin="0,10,0,0" HorizontalAlignment="Left" Padding="14,7"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Content="{loc:T Settings.Language.OpenFolder}"
                               Command="{Binding OpenLanguageFolderCommand}" />
                </StackPanel>
            </ui:Card>

            <!-- Güncellemeler: sürüm, açılışta kontrol ve elle kontrol -->
            <ui:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings.Updates}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T Settings.Updates.Body}"
                               TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Updates.InstalledVersionText}" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="InstalledVersion" />

                    <CheckBox Margin="0,10,0,0"
                              Content="{loc:T Settings.Updates.AutoCheck}"
                              IsChecked="{Binding CheckForUpdates}" />

                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Padding="14,7" Margin="0,0,8,0"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Content="{loc:T Settings.Updates.CheckNow}"
                                   ToolTip="{loc:T Settings.Updates.CheckNow.Tip}"
                                   AutomationProperties.AutomationId="CheckForUpdatesButton"
                                   Command="{Binding Updates.CheckNowCommand}" />
                        <ui:Button Padding="14,7" Appearance="Primary"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Content="{loc:T Update.Install}"
                                   ToolTip="{loc:T Update.Install.Tip}"
                                   Command="{Binding Updates.InstallCommand}"
                                   Visibility="{Binding Updates.CanInstall, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding Updates.StatusText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Opacity="0.85"
                               AutomationProperties.AutomationId="UpdateStatusText"
                               Visibility="{Binding Updates.StatusText, Converter={StaticResource TextToVis}}" />
                </StackPanel>
            </ui:Card>

            <!-- SteamCMD kartı yalnızca Steam'i destekleyen ürünlerde -->
            <ui:Card Padding="20" Margin="0,0,0,16"
                     Visibility="{Binding SupportsSteam, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings.SteamCmd}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="{loc:T Settings.SteamCmd.Body}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding SteamCmdPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:T Settings.SteamCmd.Placeholder}" />

                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   AutomationProperties.Name="{loc:T Settings.SteamCmd.Pick.Tip}"
                                   ToolTip="{loc:T Settings.SteamCmd.Pick.Tip}"
                                   Command="{Binding BrowseSteamCmdCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Padding="14,7"
                                   Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                   Content="{loc:T Settings.SteamCmd.Verify}"
ToolTip="{loc:T Settings.SteamCmd.Verify.Tip}"
                                   Command="{Binding VerifySteamCmdCommand}" />
                        <ui:Button Margin="8,0,0,0" Padding="14,7"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Content="{loc:T Settings.SteamCmd.Download}"
ToolTip="{loc:T Settings.SteamCmd.Download.Tip}"
                                   Command="{Binding DownloadSteamCmdCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- BuildPatchTool: Epic tarafının aracı. SteamCMD'den ayrı bir kart,
                 çünkü akışı da farklı — indirme seçeneği yok. -->
            <!-- Steam finans anahtarları: profil başına, her Steamworks şirketinin kendi anahtarı -->
            <ui:Card Padding="20" Margin="0,0,0,16"
                     Visibility="{Binding SupportsSteam, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings.Financial}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T Settings.Financial.Body}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding FinancialStorageText}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,0,0,12" />

                    <!-- İlk sürümden kalan, profile bağlı olmayan anahtar -->
                    <Border Background="#14FFFFFF" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding HasLegacyFinancialKey, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings.Financial.Legacy}" TextWrapping="Wrap" />
                            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Content="{loc:T Settings.Financial.RemoveLegacy}"
                                       Command="{Binding DeleteLegacyFinancialKeyCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{loc:T Settings.Financial.NoProfiles}" Opacity="0.7"
                               Visibility="{Binding HasFinancialProfiles, Converter={StaticResource BoolToVisInverted}}" />

                    <ItemsControl ItemsSource="{Binding FinancialKeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverted}}">
                                                <ui:Button Margin="0,0,8,0"
                                                           Icon="{ui:SymbolIcon ArrowImport24}"
                                                           Content="{loc:T Settings.Financial.UseLegacy}"
                                                           Command="{Binding MoveLegacyCommand}"
                                                           Visibility="{Binding DataContext.HasLegacyFinancialKey,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource BoolToVis}}" />
                                                <ui:Button Margin="0,0,8,0"
                                                           Icon="{ui:SymbolIcon Key24}"
                                                           Content="{Binding EditText}"
                                                           Command="{Binding EditCommand}" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                           Content="{loc:T Settings.Financial.Remove}"
                                                           Command="{Binding RemoveCommand}"
                                                           Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:PasswordBox Password="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            PlaceholderText="{loc:T Settings.Financial.Placeholder}"
                                                            AutomationProperties.Name="{loc:T Settings.Financial.Placeholder}" />
                                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary"
                                                       Icon="{ui:SymbolIcon Key24}"
                                                       Content="{loc:T Settings.Financial.Save}"
                                                       Command="{Binding SaveCommand}"
                                                       IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
                                            <ui:Button Grid.Column="2" Margin="8,0,0,0"
                                                       Content="{loc:T Common.Cancel}"
                                                       Command="{Binding CancelCommand}" />
                                        </Grid>

                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,6,0,0"
                                                   Visibility="{Binding Message, Converter={StaticResource TextToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button Margin="0,8,0,0" HorizontalAlignment="Left" Appearance="Transparent"
                               Icon="{ui:SymbolIcon Open24}"
                               Content="{loc:T Settings.Financial.OpenGroups}"
                               Command="{Binding OpenFinancialGroupsPageCommand}" />

                    <!-- Satış tutarlarının yanında gösterilen para birimi -->
                    <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T Settings.Currency}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" MinWidth="220"
                                          ItemsSource="{Binding CurrencyOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedCurrency}"
                                          AutomationProperties.Name="{loc:T Settings.Currency}" />
                            </Grid>
                            <TextBlock Text="{loc:T Settings.Currency.Hint}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Telefona aktar: Android'deki Pipe Manager Pulse için QR ve kod -->
                    <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T Settings.Phone}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1"
                                           Icon="{ui:SymbolIcon QrCode24}"
                                           Content="{loc:T Settings.Phone.Show}"
                                           Command="{Binding ShowPairingCommand}"
                                           Visibility="{Binding IsPairingVisible, Converter={StaticResource BoolToVisInverted}}" />
                            </Grid>
                            <TextBlock Text="{loc:T Settings.Phone.Body}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
                            <TextBlock Text="{loc:T Settings.Phone.Preparing}" FontSize="12" Opacity="0.7" Margin="0,6,0,0"
                                       Visibility="{Binding IsPreparingPairing, Converter={StaticResource BoolToVis}}" />

                            <Grid Margin="0,12,0,0" Visibility="{Binding IsPairingVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:QrCodeView Width="260" Height="260" Modules="{Binding PairingModules}" />
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Settings.Phone.Code}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding PairingCode}" FontSize="30" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" />
                                    <TextBlock Text="{Binding PairingSummary}" FontSize="12" Opacity="0.7" Margin="0,4,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon Copy24}" Content="{loc:T Settings.Phone.Copy}" Click="CopyPairingText" />
                                        <ui:Button Icon="{ui:SymbolIcon EyeOff24}" Content="{loc:T Settings.Phone.Hide}" Command="{Binding HidePairingCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,16"
                     Visibility="{Binding SupportsEpic, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{loc:T Epic.Tool}"
                                   FontWeight="SemiBold" FontSize="16" />

                        <Border Grid.Column="1" Background="#33B8860B" CornerRadius="4"
                                Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Epic.ExperimentalBadge}" FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="{loc:T Epic.Tool.Body}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding BuildPatchToolPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:T Epic.Tool.Placeholder}" />

                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   AutomationProperties.Name="{loc:T Epic.Tool.Pick.Tip}"
                                   ToolTip="{loc:T Epic.Tool.Pick.Tip}"
                                   Command="{Binding BrowseBuildPatchToolCommand}" />
                    </Grid>

                    <ui:Button Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Content="{loc:T Settings.SteamCmd.Verify}"
                               ToolTip="{loc:T Epic.Tool.Verify.Tip}"
                               Command="{Binding VerifyBuildPatchToolCommand}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings.Timeouts}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="{loc:T Settings.Timeouts.Body}" />

                    <TextBlock Text="{loc:T Settings.StallSeconds}" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding StallWarningSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Opacity="0.55" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{loc:T Settings.StallSeconds.Hint}" />

                    <TextBlock Text="{loc:T Settings.SessionTimeout}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <ui:TextBox Text="{Binding SessionCheckTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings.DataLocation}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding WorkspaceRoot}" TextWrapping="Wrap" Opacity="0.8"
                               FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />

                    <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Margin="0,8,0,0"
                               Text="{loc:T Settings.DataLocation.Body}" />

                    <ui:Button Margin="0,12,0,0" HorizontalAlignment="Left" Padding="14,7"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Content="{loc:T Settings.OpenFolder}"
ToolTip="{loc:T Settings.OpenFolder.Tip}"
                               Command="{Binding OpenWorkspaceFolderCommand}" />
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal">
                <ui:Button Appearance="Primary" Padding="16,7"
                           Icon="{ui:SymbolIcon Save24}"
                           Content="{loc:T Common.Save}"
ToolTip="{loc:T Settings.Save.Tip}"
                           Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Opacity="0.85" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
