<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SteamPipeManager.Core\SteamPipeManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Üç ürün, tek koddan. Yayımlarken seçiliyor:
      dotnet publish -p:SpmProduct=PipeManagerHub
    Geçerli değerler: SteamPipeManager (varsayılan), EpicBuildManager, PipeManagerHub.
  -->
  <PropertyGroup>
    <SpmProduct Condition="'$(SpmProduct)' == ''">SteamPipeManager</SpmProduct>

    <SpmProductName Condition="'$(SpmProduct)' == 'SteamPipeManager'">Steam Pipe Manager</SpmProductName>
    <SpmProductName Condition="'$(SpmProduct)' == 'EpicBuildManager'">Epic Build Manager</SpmProductName>
    <SpmProductName Condition="'$(SpmProduct)' == 'PipeManagerHub'">Pipe Manager Hub</SpmProductName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Koşullu derleme yerine meta veri: tek kod yolu, hepsi her üründe derleniyor. -->
    <AssemblyMetadata Include="SpmProduct" Value="$(SpmProduct)" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyTitle>$(SpmProductName)</AssemblyTitle>
    <Product>$(SpmProductName)</Product>
    <Description>Tek bir SteamCMD kurulumundan birden çok Steam hesabı, oyun ve yan uygulamanın build'lerini yönetir.</Description>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Kendi kendine yeten klasör dağıtımı: kullanıcıda .NET kurulumu gerekmiyor.

      Tek dosya (PublishSingleFile + sıkıştırma) bilerek kullanılmıyor: kendi kendini
      açan sıkıştırılmış exe'ler SmartScreen ve kurumsal virüs taramalarında sık sık
      şüpheli işaretleniyor ve indirme engelleniyordu. Sıradan bir exe ile yanındaki
      DLL'ler bu tetiklemeyi yapmıyor.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Dil dosyaları exe'ye gömülür: tek dosya dağıtımda yanında klasör taşımak
      gerekmesin. İlk çalıştırmada kullanıcının düzenleyebileceği dil klasörüne
      açılır; oradaki sürüm önceliklidir ve üzerine yazılmaz.
    -->
    <EmbeddedResource Include="lang\*.json" />
  </ItemGroup>

</Project>
