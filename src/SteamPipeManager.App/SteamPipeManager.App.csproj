<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SteamPipeManager.Core\SteamPipeManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Steam Pipe Manager</AssemblyTitle>
    <Product>Steam Pipe Manager</Product>
    <Description>Tek bir SteamCMD kurulumundan birden çok Steam hesabı, oyun ve yan uygulamanın build'lerini yönetir.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Tek dosya dağıtım: kullanıcıda .NET kurulumu gerekmesin. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Dil dosyaları exe'ye gömülür: tek dosya dağıtımda yanında klasör taşımak
      gerekmesin. İlk çalıştırmada kullanıcının düzenleyebileceği dil klasörüne
      açılır; oradaki sürüm önceliklidir ve üzerine yazılmaz.
    -->
    <EmbeddedResource Include="lang\*.json" />
  </ItemGroup>

</Project>
