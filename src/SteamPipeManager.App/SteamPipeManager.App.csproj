<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SteamPipeManager.Core\SteamPipeManager.Core.csproj" />
    <ProjectReference Include="..\SteamPipeManager.Presentation\SteamPipeManager.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Ürün kimliği ve sürüm Avalonia uygulamasıyla ortak. -->
  <Import Project="..\Product.props" />

  <PropertyGroup>
    <!--
      Kendi kendine yeten klasör dağıtımı: kullanıcıda .NET kurulumu gerekmiyor.

      Tek dosya (PublishSingleFile + sıkıştırma) bilerek kullanılmıyor: kendi kendini
      açan sıkıştırılmış exe'ler SmartScreen ve kurumsal virüs taramalarında sık sık
      şüpheli işaretleniyor ve indirme engelleniyordu. Sıradan bir exe ile yanındaki
      DLL'ler bu tetiklemeyi yapmıyor.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>


</Project>
