<Application x:Class="SteamPipeManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:SteamPipeManager.App.Converters"
             xmlns:loc="clr-namespace:SteamPipeManager.App.Localization">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibility x:Key="BoolToVis" />
            <conv:BoolToVisibility x:Key="BoolToVisInverted" Invert="True" />
            <conv:StringToVisibility x:Key="TextToVis" />
            <conv:InverseBool x:Key="InverseBool" />
            <conv:NullToVisibility x:Key="NullToVis" />
            <conv:CountToVisibility x:Key="CountToVis" />
            <conv:CountToVisibility x:Key="CountToVisInverted" Invert="True" />
            <conv:SeverityToBrush x:Key="SeverityBrush" />
            <conv:PathToImage x:Key="PathToImage" />
            <conv:OutcomeToText x:Key="OutcomeText" />

            <Thickness x:Key="CardPadding">16</Thickness>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
