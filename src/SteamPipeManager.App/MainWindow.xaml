<ui:FluentWindow x:Class="SteamPipeManager.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:SteamPipeManager.App.Localization"
                 xmlns:views="clr-namespace:SteamPipeManager.App.Views"
                 xmlns:conv="clr-namespace:SteamPipeManager.App.Converters"
                 Title="{Binding ProductName}"
                 Width="1280" Height="820"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibility x:Key="BoolToVisibilityInverted" Invert="True" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding ProductName}" />

        <!-- Breadcrumb: ev ikonu → profil avatarı → oyun adı -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="24,8,24,16"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVisibility}}">

            <ui:Button Appearance="Transparent" Padding="8,6"
                       Icon="{ui:SymbolIcon Home24}"
                       AutomationProperties.Name="{loc:T Nav.Home}"
                       ToolTip="{loc:T Nav.Home.Tip}"
                       Command="{Binding GoToProfilesCommand}" />

            <TextBlock Text="›" Margin="8,0" Opacity="0.4" VerticalAlignment="Center" FontSize="15"
                       Visibility="{Binding Navigation.HasProfile, Converter={StaticResource BoolToVisibility}}" />

            <!-- Profil: yalnızca avatar; adı tooltip'te -->
            <ui:Button Appearance="Transparent" Padding="4"
                       AutomationProperties.Name="{Binding ActiveProfileTooltip}"
                       ToolTip="{Binding ActiveProfileTooltip}"
                       Command="{Binding GoToAppsCommand}"
                       Visibility="{Binding Navigation.HasProfile, Converter={StaticResource BoolToVisibility}}">
                <!-- Rozet 26x26; oturum noktası taşabilsin diye kap biraz daha geniş. -->
                <Grid Width="30" Height="30">
                    <Border CornerRadius="13" Background="#2F6FEB" Width="26" Height="26"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding HasActiveAvatar, Converter={StaticResource BoolToVisibilityInverted}}">
                        <TextBlock Text="{Binding ActiveInitial}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Border CornerRadius="13" Width="26" Height="26"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="{Binding HasActiveAvatar, Converter={StaticResource BoolToVisibility}}">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding ActiveAvatarPath, Converter={StaticResource PathToImage}}" />
                        </Border.Background>
                    </Border>

                    <!-- Oturum durumu: avatarın sağ alt köşesinde küçük bir nokta.
                         Dış halka pencere zeminiyle aynı renkte, böylece koyu bir
                         avatarın üzerinde de nokta okunur kalıyor. -->
                    <Border Width="12" Height="12" CornerRadius="6"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{DynamicResource ApplicationBackgroundBrush}">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{Binding ActiveSessionBrush}" />
                    </Border>
                </Grid>
            </ui:Button>

            <TextBlock Text="›" Margin="8,0" Opacity="0.4" VerticalAlignment="Center" FontSize="15"
                       Visibility="{Binding Navigation.HasApp, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding Navigation.App.Title}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="14"
                       Visibility="{Binding Navigation.HasApp, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,24,16"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Visibility="{Binding IsChromeVisible, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Appearance="Transparent" Padding="9,6"
                       Icon="{ui:SymbolIcon Settings24}"
                       AutomationProperties.Name="{loc:T Nav.Settings}"
                                   ToolTip="{loc:T Nav.Settings}"
                       Command="{Binding OpenSettingsCommand}"
                       Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibilityInverted}}" />
            <ui:Button Appearance="Transparent" Padding="9,6"
                       Icon="{ui:SymbolIcon ArrowLeft24}"
                       AutomationProperties.Name="{loc:T Nav.Back}"
                                   ToolTip="{loc:T Nav.Back}"
                       Command="{Binding CloseSettingsCommand}"
                       Visibility="{Binding IsSettings, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="24,0,24,24">

            <!-- Güncelleme şeridi: yeni sürüm, indirme ilerlemesi ya da "güncellendi" bildirimi.
                 Her sayfanın üstünde; kurulum yalnızca düğmeye basınca başlıyor. -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="14,10" CornerRadius="6"
                    Background="#1F2F6FEB" BorderBrush="#552F6FEB" BorderThickness="1"
                    DataContext="{Binding Updates}"
                    AutomationProperties.AutomationId="UpdateBanner"
                    Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSync24" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="UpdateBannerText" />
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding Note, Converter={StaticResource TextToVis}}" />
                        <ProgressBar Margin="0,6,0,0" Height="4" Minimum="0" Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ui:Button Appearance="Primary" Padding="12,6"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Content="{loc:T Update.Install}"
                                   ToolTip="{loc:T Update.Install.Tip}"
                                   AutomationProperties.AutomationId="UpdateInstallButton"
                                   Command="{Binding InstallCommand}"
                                   Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Margin="8,0,0,0" Padding="12,6"
                                   Icon="{ui:SymbolIcon Open24}"
                                   Content="{Binding ReleasePageLabel}"
                                   Command="{Binding OpenReleasePageCommand}"
                                   Visibility="{Binding CanOpenReleasePage, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Margin="4,0,0,0" Padding="8,6" Appearance="Transparent"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   AutomationProperties.Name="{loc:T Update.Later}"
                                   ToolTip="{loc:T Update.Later}"
                                   Command="{Binding DismissCommand}"
                                   Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

        <Grid>
            <views:ProfilePickerView DataContext="{Binding ProfilePicker}"
                                     Visibility="{Binding DataContext.IsProfilePicker,
                                                  RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource BoolToVisibility}}" />

            <views:AppPickerView DataContext="{Binding AppPicker}"
                                 Visibility="{Binding DataContext.IsAppPicker,
                                              RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource BoolToVisibility}}" />

            <views:SubAppWorkspaceView DataContext="{Binding Workspace}"
                                       Visibility="{Binding DataContext.IsSteamWorkspace,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVisibility}}" />

            <views:EpicWorkspaceView DataContext="{Binding EpicWorkspace}"
                                     Visibility="{Binding DataContext.IsEpicWorkspace,
                                                  RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource BoolToVisibility}}" />

            <views:SetupView DataContext="{Binding Setup}"
                             Visibility="{Binding DataContext.IsSetup,
                                          RelativeSource={RelativeSource AncestorType=Window},
                                          Converter={StaticResource BoolToVisibility}}" />

            <views:SettingsView DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsSettings,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        </DockPanel>

        <!-- Giriş penceresi tüm satırların üstünü kaplar -->
        <views:LoginOverlay Grid.Row="0" Grid.RowSpan="3"
                            DataContext="{Binding Login}" />
    </Grid>
</ui:FluentWindow>
